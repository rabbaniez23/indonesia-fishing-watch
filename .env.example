# Salin menjadi .env.local lalu isi. File .env.local tidak pernah di-commit.

# Lokasi database SQLite (default: ./data/indonesia-fishing-watch.db)
# DATABASE_PATH=./data/indonesia-fishing-watch.db

# Admin pertama untuk `npm run seed:admin`. Hapus ADMIN_PASSWORD setelah berhasil masuk.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Alamat publik aplikasi: dipakai tautan undangan (`npm run invite`) dan pemeriksaan origin form
# di balik tunnel/domain (mis. Tailscale Funnel). Dibaca saat build — build ulang setelah mengubahnya.
# APP_BASE_URL=http://localhost:3000

# Tahap 2: token API Global Fishing Watch. Hanya dibaca di server; jangan memakai prefix NEXT_PUBLIC_.
# GFW_API_ACCESS_TOKEN=
